# ==============================================================================
# Archive — Environment Variables Template
# ==============================================================================

# Firebase Configuration (BaaS Serverless)
VITE_FIREBASE_API_KEY="your-api-key-here"
VITE_FIREBASE_AUTH_DOMAIN="archive-personal.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="archive-personal"
VITE_FIREBASE_STORAGE_BUCKET="archive-personal.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# Cloudinary CDN Configuration (Media Pipeline)
VITE_CLOUDINARY_CLOUD_NAME="your-cloud-name"
VITE_CLOUDINARY_UPLOAD_PRESET="archive_unsigned_preset"
